---
import site from '../../data/site.json';

// LV's footer shape (Help / Services / About / Connect), fitted to what this
// site actually has. footerLinks stays one flat array in site.json — no
// schema change needed — split here by label into the three groups that make
// sense for a small commission business, alongside site.nav for "Explore".
const explore = [...site.nav, { label: 'Trade', href: '/trade' }];
const help = site.footerLinks.filter((l) => ['FAQ', 'Care'].includes(l.label));
const legal = site.footerLinks.filter((l) => ['Terms', 'Privacy'].includes(l.label));
---

<footer class="bg-ink text-paper">
  <div class="shell py-16 sm:py-20">
    <div class="grid gap-12 sm:gap-10 sm:grid-cols-2 md:grid-cols-12">
      <!-- Statement + company details + the ONE enquiry CTA in the footer
           (previously repeated three times across this component). -->
      <div class="sm:col-span-2 md:col-span-4">
        <p class="display text-2xl sm:text-3xl m-0 mb-4 max-w-[18ch]">
          Bespoke handmade rugs, made once.
        </p>
        <a href={site.enquireLink.href} class="link-underline text-paper text-sm font-medium">
          Start a commission &rarr;
        </a>

        <!-- Company name and trading address block removed 2026-09-13 until an address exists;
             the name stays in the copyright line. Address lives in site.json company.address. -->
      </div>

      <div class="md:col-span-3">
        <p class="eyebrow text-paper/65 mb-5">Explore</p>
        <ul class="space-y-2.5 list-none p-0 m-0">
          {explore.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-paper/75 hover:text-paper no-underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="eyebrow text-paper/65 mb-5">Help</p>
        <ul class="space-y-2.5 list-none p-0 m-0">
          {help.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-paper/75 hover:text-paper no-underline">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${site.company.email}`} class="text-sm text-paper/75 hover:text-paper no-underline break-all">
              {site.company.email}
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <p class="eyebrow text-paper/65 mb-5">Legal</p>
        <ul class="space-y-2.5 list-none p-0 m-0">
          {legal.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-paper/75 hover:text-paper no-underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-paper/15 mt-14 pt-7 text-xs text-paper/65">
      <p class="m-0">&copy; {new Date().getFullYear()} {site.company.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
