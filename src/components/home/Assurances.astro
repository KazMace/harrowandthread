---
// Trust built from what is verifiably true today, not from borrowed credibility.
// This business has no clients yet, so it cannot show testimonials, ratings or a
// portfolio — inventing any of those is a banned practice under the UK DMCC Act
// 2024. What it CAN do is state the commitments it actually stands behind, which
// are otherwise buried in /terms where nobody reads them before enquiring.
const assurances = [
  {
    title: 'Nothing is made until you approve it',
    body: 'You see the design mapped to your exact dimensions, and confirm the colour references in writing, before a single thread is tufted.',
  },
  {
    title: 'Yours alone, permanently',
    body: 'We will never remake your design, sell it, or license it to anyone else. One commission, one piece, no second edition.',
  },
  {
    title: 'Insured in transit, at our expense',
    body: 'Every shipment is fully insured at full value. If it is lost or damaged on the way to you, we handle the claim and prioritise a replacement.',
  },
  {
    title: 'Your statutory rights are untouched',
    body: 'Bespoke goods are not returnable once production starts, but your rights under the Consumer Rights Act 2015 — including for a faulty piece — are unaffected.',
  },
];
---

<section class="section-pad bg-chalk">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-12 sm:mb-16">
      <h2 class="display text-3xl sm:text-4xl m-0 max-w-[16ch]">
        What you're covered for.
      </h2>
      <p class="text-sm text-graphite max-w-[40ch] m-0">
        A commission is a significant commitment made before you can touch the
        finished piece. These are the terms that protect you, stated up front
        rather than buried in the small print.
      </p>
    </div>

    <div class="grid gap-10 sm:gap-x-8 sm:gap-y-12 sm:grid-cols-2 stagger reveal">
      {assurances.map((a) => (
        <div class="border-t-2 border-ink pt-6">
          <h3 class="display text-xl sm:text-2xl mb-3">{a.title}</h3>
          <p class="prose-body text-graphite m-0">{a.body}</p>
        </div>
      ))}
    </div>

    <p class="text-sm text-graphite mt-12 m-0">
      Full detail in our <a href="/terms" class="link-underline text-ink">terms</a>,
      and the <a href="/faq" class="link-underline text-ink">FAQ</a> answers the
      questions we are asked most before a first commission.
    </p>
  </div>
</section>
