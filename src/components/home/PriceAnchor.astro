---
import pricing from '../../data/pricing.json';

// Deliberately quiet — a specification table, not a sale banner.
// Rates are STARTING rates (client's decision, 2026-08-11): the final figure is
// set at quote once the design is known. Every number here must carry "from".
---

<section id="rates" class="section-pad border-t rule">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-10 sm:mb-14">
      <h2 class="display text-3xl sm:text-4xl m-0">Rates</h2>
      <p class="text-sm text-graphite max-w-[42ch] m-0">
        Priced by area and design tier, and the rate covers the whole piece:
        material, dyeing, weaving, finishing and insured delivery to the
        UK, Europe and the United States, with an additional freight charge for
        exceptionally large or heavy pieces. Your rate is confirmed at quote,
        once we know the design.
      </p>
    </div>

    <dl class="m-0 border-t-2 border-ink lg:grid lg:grid-cols-3">
      {pricing.tiers.map((tier) => (
        <div class="grid gap-2 sm:gap-12 sm:grid-cols-[minmax(0,14rem)_minmax(0,11rem)_1fr] items-baseline border-b rule py-7 sm:py-8
                    lg:flex lg:flex-col lg:items-start lg:gap-3 lg:border-b-0 lg:border-r lg:rule lg:py-10 lg:pl-8 lg:pr-8 lg:first:pl-0 lg:last:border-r-0 lg:last:pr-0">
          <dt class="display text-2xl sm:text-3xl m-0">{tier.name}</dt>
          <dd class="m-0 text-xl sm:text-2xl tabular-nums whitespace-nowrap">
            <span class="text-base text-graphite tracking-normal">from </span>&pound;{tier.rate.toLocaleString()}<span class="text-base text-graphite">/m&sup2;</span>
          </dd>
          <dd class="m-0 prose-body text-graphite">{tier.description}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-10 sm:mt-12 flex flex-wrap items-start justify-between gap-8">
      <div class="max-w-[54ch]">
        <p class="text-base text-ink m-0 mb-3">
          A 3 &times; 2m rug in a single colour starts at &pound;3,600. The same
          size, pictorial, starts at &pound;7,200.
        </p>
        <p class="text-sm text-graphite m-0">
          A &pound;{pricing.designFee} design fee applies only if you ask us to assign
          a designer, and is credited in full against your commission.
          {pricing.customsNote}
        </p>
      </div>
      <a href="/commissions#pricing" class="link-underline text-sm font-medium shrink-0">
        Worked examples and full pricing &rarr;
      </a>
    </div>
  </div>
</section>
