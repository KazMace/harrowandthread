---
import pricing from '../../data/pricing.json';

// Deliberately quiet. An earlier version rendered this as a full-bleed red
// banner reading "COMMISSIONS FROM £750/m²" — retail sale grammar, anchored on
// the cheapest tier, and it read as promotional rather than premium. Rates are
// now presented as a specification table: complete, unhurried, no "from".
---

<section id="rates" class="section-pad border-t rule">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-10 sm:mb-14">
      <h2 class="display text-3xl sm:text-4xl m-0">Rates</h2>
      <p class="text-sm text-graphite max-w-[42ch] m-0">
        Commissions are priced by area and design tier. The rate is the whole
        price of the piece &mdash; material, dyeing, tufting, finishing and
        insured delivery to the UK, Europe and the United States.
      </p>
    </div>

    <dl class="m-0 border-t-2 border-ink">
      {pricing.tiers.map((tier) => (
        <div class="grid gap-2 sm:gap-12 sm:grid-cols-[minmax(0,14rem)_minmax(0,8rem)_1fr] items-baseline border-b rule py-7 sm:py-8">
          <dt class="display text-2xl sm:text-3xl m-0">{tier.name}</dt>
          <dd class="m-0 text-xl sm:text-2xl tabular-nums whitespace-nowrap">
            &pound;{tier.rate.toLocaleString()}<span class="text-base text-graphite">/m&sup2;</span>
          </dd>
          <dd class="m-0 prose-body text-graphite">{tier.description}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-10 sm:mt-12 flex flex-wrap items-start justify-between gap-8">
      <div class="max-w-[54ch]">
        <p class="text-base text-ink m-0 mb-3">
          A 3 &times; 2m rug, plain, is &pound;4,500. A 4 &times; 3m pictorial is &pound;18,000.
        </p>
        <p class="text-sm text-graphite m-0">
          A &pound;{pricing.designFee} design fee applies only if you ask us to assign
          a designer, and is credited in full against your commission. Import
          duties and destination VAT are payable by the recipient on arrival.
        </p>
      </div>
      <a href="/commissions#pricing" class="link-underline text-sm font-medium shrink-0">
        Worked examples and full pricing &rarr;
      </a>
    </div>
  </div>
</section>
