---
const steps = [
  {
    n: '01',
    title: 'Design',
    body: 'Bring an idea, a sketch, or a reference image. We map it to your exact dimensions — or assign a designer to work alongside you.',
  },
  {
    n: '02',
    title: 'Sign-off and deposit',
    body: 'Approve the design and the colour references. Production begins on receipt of the 50% deposit. That deposit is non-refundable from the point it is paid.',
  },
  {
    n: '03',
    title: 'Made and shipped',
    body: 'About six to seven weeks from sign-off for a straightforward piece. Scale and complexity extend it — your date is confirmed at sign-off, before the deposit.',
  },
];
---

<!-- Archetype: horizontal numbered sequence on chalk. -->
<section class="section-pad bg-chalk">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-12 sm:mb-16">
      <h2 class="display text-3xl sm:text-4xl lg:text-5xl m-0 max-w-[14ch]">
        Three steps, six to seven weeks.
      </h2>
      <a href="/commissions" class="link-underline text-sm font-medium shrink-0">
        The full commission process &rarr;
      </a>
    </div>

    <ol class="grid gap-10 sm:gap-8 sm:grid-cols-3 list-none p-0 m-0 stagger reveal">
      {steps.map((s) => (
        <li class="border-t-2 border-ink pt-6">
          <span class="eyebrow text-graphite block mb-6">{s.n}</span>
          <h3 class="display text-2xl mb-3">{s.title}</h3>
          <p class="prose-body text-graphite m-0">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
