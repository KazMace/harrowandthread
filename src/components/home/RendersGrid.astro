---
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

// Direction A: catalogue plates, not a tile grid. Each piece gets the full
// measure, shown whole at its natural aspect ratio with a specification
// caption beneath — the way a serious object is photographed for a catalogue.
//
// Sizes are read off the imagery itself — measured against the furniture — so a
// caption never claims a piece is smaller than the picture shows. Client audit,
// 2026-08-11: the library plate said 4 x 3m for what is plainly about 8 x 6m.
//
// Two rules meet here. No rug may ever be cropped, so width/height MUST match
// the file on disk (ImagePlaceholder sets aspect-ratio from them) and nothing
// uses object-cover. And a rug only reads as its real size when the room does
// the work, so every caption names the size the picture is showing.
const plates = [
  {
    id: 'render-rug-01', width: 1600, height: 900, no: 'I',
    title: 'Morning room, 6 × 4m',
    spec: 'Pictorial · wool · 12mm pile · mineral green, moss, stone, ivory, clay',
    alt: 'A handmade rug with a painterly abstract design in mineral green, stone and clay, shown whole under a linen sofa and two velvet armchairs in a green-walled country house morning room',
  },
  {
    id: 'render-rug-04', width: 1600, height: 900, no: 'II',
    title: 'Dining room, 8 × 5m',
    spec: 'Pictorial · wool · hand-knotted · stone, clay, muted green on ivory',
    alt: 'A hand-knotted rug with an all-over classical palmette design in stone, clay and muted green, shown whole beneath a long mahogany dining table and twelve velvet chairs in a green dining room',
  },
  {
    id: 'render-rug-02', width: 1600, height: 900, no: 'III',
    title: 'Library, 5 × 4m',
    spec: 'Geometric · wool · 6mm pile · charcoal, ochre, cream',
    alt: 'A handmade rug with a restrained geometric grid design in charcoal, ochre and cream, shown whole beneath two leather reading chairs in a mahogany-shelved library',
  },
  {
    id: 'render-rug-03', width: 1600, height: 900, no: 'IV',
    title: 'Principal bedroom, 6 × 4m',
    spec: 'Plain · wool · 20mm pile · deep teal, matched to a single reference',
    alt: 'A plain deep teal handmade rug with a deep pile, shown whole beneath a carved four-poster bed and a bench in a Georgian bedroom with teal curtains and pale panelled walls',
  },
  {
    id: 'render-wall-hanging-01', width: 1600, height: 1199, no: 'V',
    title: 'Wall hanging, 4 × 3m',
    spec: 'Pictorial · wool · 20mm pile · rust, plum, sage, ivory',
    alt: 'A handmade wool wall hanging with broad painterly washes of rust, plum, sage and ivory, hung flat from a turned wooden pole above a rust velvet sofa in a blue drawing room',
  },
  {
    id: 'render-wall-hanging-02', width: 1600, height: 1199, no: 'VI',
    title: 'Wall hanging, 3 × 2m',
    spec: 'Geometric · wool · 12mm pile · charcoal, ochre, cream',
    alt: 'A handmade wool wall hanging with a geometric design of interlocking rectangles in charcoal, ochre and cream, hung from an oak pole above a leather chesterfield in a panelled study',
  },
];
---

<section class="section-pad border-t rule">
  <div class="shell">
    <div class="mb-14 sm:mb-20">
      <h2 class="display text-3xl sm:text-4xl lg:text-5xl m-0 max-w-[18ch]">
        Designed for the room it goes in.
      </h2>
    </div>

    {plates.map((p) => (
      <figure class="m-0 mb-20 sm:mb-28 last:mb-0">
        <div class="max-w-[80rem] mx-auto">
          <ImagePlaceholder
            id={p.id}
            width={p.width}
            height={p.height}
            alt={p.alt}
            sizes="(min-width: 1100px) 80rem, 92vw"
            formats={['webp']}
          />
        </div>
        <figcaption class="max-w-[80rem] mx-auto mt-5 sm:mt-6">
          <h3 class="display text-2xl sm:text-3xl m-0 mb-2">{p.title}</h3>
          <p class="text-sm text-graphite m-0">{p.spec}</p>
        </figcaption>
      </figure>
    ))}

    <!-- The AI-imagery disclosure: one small line at the foot of the plates,
         not a header. Honest, quiet, out of the way (client, 2026-09-13). -->
    <p class="text-utility uppercase text-graphite text-right max-w-[80rem] mx-auto mt-10 sm:mt-14 m-0">
      Plates are design visualisations
    </p>
  </div>
</section>
