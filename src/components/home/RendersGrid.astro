---
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

// Direction A: catalogue plates, not a tile grid. Each piece gets the full
// measure, shown whole at its natural aspect ratio with a specification
// caption beneath — the way a serious object is photographed for a catalogue.
//
// Sizes are read off the imagery itself — measured against the furniture — so a
// caption never claims a piece is smaller than the picture shows. Client audit,
// 2026-08-11: the library plate said 4 x 3m for what is plainly about 8 x 6m.
//
// Two rules meet here. No rug may ever be cropped, so width/height MUST match
// the file on disk (ImagePlaceholder sets aspect-ratio from them) and nothing
// uses object-cover. And a rug only reads as its real size when the room does
// the work, so every caption names the size the picture is showing.
const plates = [
  {
    id: 'render-rug-01', width: 1600, height: 900, no: 'I',
    title: 'Reception hall, 15 × 10m',
    spec: 'Pictorial · wool · 12mm pile · indigo, madder, ochre, sage, ivory',
    alt: 'An enormous hand-tufted rug with a flowing painterly design in indigo, madder and ochre, shown whole in a double-height mansion reception hall with a grand piano and seating standing on it',
  },
  {
    id: 'render-rug-04', width: 1600, height: 900, no: 'II',
    title: 'Saloon, 12 × 8m',
    spec: 'Geometric · wool · 12mm pile · indigo, gold, ivory',
    alt: 'A large hand-tufted rug with a classical medallion design in indigo, gold and ivory, shown whole in a grand panelled saloon',
  },
  {
    id: 'render-rug-02', width: 1600, height: 1199, no: 'III',
    title: 'Library, 8 × 6m',
    spec: 'Geometric · wool · 6mm pile · charcoal, saffron, cream',
    alt: 'A hand-tufted rug with a bold geometric design in charcoal and saffron, shown whole on the floor of a panelled private library',
  },
  {
    id: 'render-rug-03', width: 1600, height: 1199, no: 'IV',
    title: 'Principal bedroom, 6 × 4m',
    spec: 'Plain · wool · 20mm pile · deep teal, matched to a single reference',
    alt: 'A plain deep teal hand-tufted rug with a deep pile, shown whole beneath a four-poster bed in a grand bedroom',
  },
  {
    id: 'render-wall-hanging-01', width: 1600, height: 1199, no: 'V',
    title: 'Wall hanging, 4 × 3m',
    spec: 'Pictorial · wool · 20mm pile · rust, plum, sage, ivory',
    alt: 'A hand-tufted wool wall hanging with a painterly abstract design, hung from wide loops threaded onto a turned wooden pole on the panelled wall of a grand saloon',
  },
  {
    id: 'render-wall-hanging-02', width: 1600, height: 1199, no: 'VI',
    title: 'Wall hanging, 3.5 × 2.5m',
    spec: 'Geometric · wool · 12mm pile · indigo, saffron, ivory',
    alt: 'A hand-tufted wool wall hanging with a bold geometric design in indigo and saffron, hung from wide loops threaded onto a turned wooden pole in a double-height drawing room',
  },
];
---

<section class="section-pad border-t rule">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-14 sm:mb-20">
      <h2 class="display text-3xl sm:text-4xl lg:text-5xl m-0 max-w-[18ch]">
        Designed for the room it goes in.
      </h2>
      <p class="text-graphite text-sm max-w-[38ch] m-0">
        Design visualisations, not photographs of delivered work.
        Portfolio in preparation.
      </p>
    </div>

    {plates.map((p) => (
      <figure class="m-0 mb-20 sm:mb-28 last:mb-0">
        <div class="bg-paper p-2 sm:p-4 max-w-[66rem] mx-auto shadow-[0_1px_0_theme(colors.hairline)]">
          <ImagePlaceholder
            id={p.id}
            width={p.width}
            height={p.height}
            alt={p.alt}
            sizes="(min-width: 1100px) 66rem, 92vw"
            formats={['webp']}
          />
        </div>
        <figcaption class="max-w-[66rem] mx-auto mt-5 sm:mt-6">
          <span class="eyebrow text-graphite block mb-2">Plate {p.no}</span>
          <h3 class="display text-2xl sm:text-3xl m-0 mb-2">{p.title}</h3>
          <p class="text-sm text-graphite m-0">{p.spec}</p>
          <p class="eyebrow text-graphite mt-3 m-0">Design visualisation</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
