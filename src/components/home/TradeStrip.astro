---
const audiences = ['Interior designers', 'Architects', 'Developers', 'Hospitality'];
---

<!-- Archetype: quiet horizontal band. Small on purpose — findable, not loud. -->
<section class="border-y rule">
  <div class="shell py-12 sm:py-16">
    <div class="grid gap-8 md:grid-cols-[auto_1fr_auto] md:items-center">
      <p class="eyebrow text-graphite m-0">Trade</p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {audiences.map((a, i) => (
          <>
            <span class="text-lg">{a}</span>
            {i < audiences.length - 1 && <span class="text-graphite/40" aria-hidden="true">/</span>}
          </>
        ))}
      </div>

      <a href="/trade" class="link-underline text-sm font-medium shrink-0 justify-self-start md:justify-self-end">
        Trade terms and specification &rarr;
      </a>
    </div>
  </div>
</section>
