---
import ImagePlaceholder from './ImagePlaceholder.astro';

// The LV rhythm, generalised from CarpetsStrip.astro (the section that already
// was this pattern): one full-measure image, one small uppercase label, one
// headline, short copy, exactly one link out. Never more than one CTA.
export interface Props {
  imageId: string;
  imageWidth: number;
  imageHeight: number;
  imageAlt: string;
  imageCaption?: string;
  /** 'contain' (default, never crops) or 'cover' — see ImagePlaceholder. Only
   *  use 'cover' on a room/context shot, never on a plate showing a whole rug. */
  fit?: 'contain' | 'cover';
  eyebrow: string;
  heading: string;
  body: string;
  linkHref: string;
  linkLabel: string;
  /** Which side the image sits on at md+. Mirrors on mobile (image first). */
  imageSide?: 'left' | 'right';
  /** Section background/text pairing. Matches the tokens already in use
   *  elsewhere (bg-indigo/text-paper on CarpetsStrip, bg-chalk on commissions). */
  tone?: 'ink' | 'indigo' | 'chalk' | 'paper';
}

const {
  imageId,
  imageWidth,
  imageHeight,
  imageAlt,
  imageCaption,
  fit = 'contain',
  eyebrow,
  heading,
  body,
  linkHref,
  linkLabel,
  imageSide = 'left',
  tone = 'chalk',
} = Astro.props;

const toneClasses: Record<string, string> = {
  ink: 'bg-ink text-paper',
  indigo: 'bg-indigo text-paper',
  chalk: 'bg-chalk text-ink',
  paper: 'bg-paper text-ink',
};

const inverted = tone === 'ink' || tone === 'indigo';
const eyebrowClass = inverted ? 'text-paper/70' : 'text-graphite';
const bodyClass = inverted ? 'text-paper/75' : 'text-graphite';
const btnClass = inverted ? 'btn-invert' : 'btn-primary';
---

<section class={toneClasses[tone]}>
  <div class="grid md:grid-cols-2 items-stretch">
    <div class={`media order-2 ${imageSide === 'right' ? 'md:order-2' : 'md:order-1'} min-h-[18rem] md:min-h-[32rem]`}>
      <ImagePlaceholder
        id={imageId}
        width={imageWidth}
        height={imageHeight}
        alt={imageAlt}
        caption={imageCaption}
        fit={fit}
        class={`w-full ${fit === 'cover' ? 'h-full' : ''}`}
        sizes="(max-width: 1024px) 100vw, 50vw"
      />
    </div>

    <div class={`order-1 ${imageSide === 'right' ? 'md:order-1' : 'md:order-2'} flex items-center`}>
      <div class="px-6 py-14 sm:px-14 sm:py-20 lg:px-20">
        <p class={`eyebrow ${eyebrowClass} mb-6`}>{eyebrow}</p>
        <h2 class="display text-3xl sm:text-4xl lg:text-5xl mb-6 max-w-[14ch]">
          {heading}
        </h2>
        <p class={`${bodyClass} text-lg mb-8 max-w-[38ch]`}>
          {body}
        </p>
        <a href={linkHref} class={`btn ${btnClass}`}>{linkLabel}</a>
      </div>
    </div>
  </div>
</section>
