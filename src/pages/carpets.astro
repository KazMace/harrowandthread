---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';
import pricing from '../data/pricing.json';
import site from '../data/site.json';

// The four material rules plus supply-only. All legally material information:
// they stay prominent, uncollapsed, and on this page.
const rules = [
  {
    n: '01',
    title: 'Supply only',
    paras: [
      'Your carpet arrives oversized by design. A fitter trims it to your room. We can arrange UK fitting on request: ask when you enquire.',
    ],
  },
  {
    n: '02',
    title: 'Measurement',
    paras: [
      'You supply the <strong class="text-ink font-medium">two longest measurements</strong> of the room. This is the standard trade method and correctly accounts for bay windows, chimney breasts and alcoves.',
      'We add approximately <strong class="text-ink font-medium">10cm to each dimension</strong> as a trimming allowance.',
      '<strong class="text-ink font-medium">You are responsible for the accuracy of your measurements.</strong> A professional measure is recommended.',
    ],
  },
  {
    n: '03',
    title: 'Charged area',
    paras: [
      'You pay for the <strong class="text-ink font-medium">full rectangle</strong>. That includes the area trimmed away around a bay or chimney breast.',
      'The proposal shows the charged area in m&sup2; and states that trimming waste is included, <strong class="text-ink font-medium">before the deposit</strong>.',
    ],
  },
  {
    n: '04',
    title: 'Pattern trimming',
    paras: [
      'The design is centred to the ordered rectangle. <strong class="text-ink font-medium">Trimming at a bay or chimney breast will cut into the pattern.</strong>',
      'On a pictorial design, plan the layout with us first. We will show you where the cuts fall before anything is made.',
    ],
  },
];

const extras = [
  { title: 'Design fee', body: pricing.designFeeNote },
  { title: 'Shipping', body: pricing.shippingNote },
  { title: 'Customs and duties', body: pricing.customsNote },
];
---

<BaseLayout
  title="Bespoke Wall-to-Wall Carpets, Made to Your Room | Harrow &amp; Thread"
  description="Hand-woven wall-to-wall carpets made to your room and your design, from 1,400 dye colours. Priced individually on the charged area, in a written proposal before any deposit. Supply only, with full measurement guidance."
>
  <!-- Archetype: page header. -->
  <section class="section-pad">
    <div class="shell">
      <p class="eyebrow text-graphite mb-6">Wall-to-wall carpets</p>
      <h1 class="display text-4xl sm:text-5xl lg:text-6xl m-0 mb-8 max-w-[18ch]">
        Made to your room.<br />Your design. Your colour.
      </h1>
      <p class="lede text-graphite m-0 max-w-[46ch]">
        Hand-woven wall-to-wall carpets. All three design tiers (plain, geometric and pictorial), the same 1,400 colours. Supply only, with full measurement guidance.
      </p>
    </div>
  </section>

  <!-- Archetype: numbered sequence on chalk. Material information, open. -->
  <section class="section-pad bg-chalk">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12 sm:mb-16">
        <h2 class="display text-3xl sm:text-4xl m-0">Before you order</h2>
        <p class="text-sm text-graphite max-w-[40ch] m-0">
          A fitted carpet is made once, to numbers you supply. Everything that affects the price or the fit is here, before you commit.
        </p>
      </div>

      <div class="grid gap-10 sm:gap-x-8 sm:gap-y-14 sm:grid-cols-2 stagger reveal">
        {rules.map((r) => (
          <div class="border-t-2 border-ink pt-6">
            <h3 class="display text-2xl mb-4">{r.title}</h3>
            <div class="space-y-3">
              {r.paras.map((para) => (
                <p class="prose-body text-graphite m-0" set:html={para}></p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Archetype: full-bleed colour statement. How a carpet is priced, in the
       open. No rate card: prices left the site 2026-09-13 (client decision). -->
  <section class="bg-ink text-paper">
    <div class="shell py-12 sm:py-20">
      <p class="eyebrow text-paper/70 mb-6">Investment</p>
      <h2 class="display text-3xl xs:text-4xl sm:text-5xl lg:text-6xl m-0 mb-8 max-w-[14ch]">
        Priced for the room.
      </h2>
      <p class="text-lg sm:text-xl text-paper/90 m-0 max-w-[46ch]">
        Every carpet is priced on its charged area. Your written proposal shows
        that area, with trimming waste included, and sets out the investment in
        full before any deposit.
      </p>
    </div>

    <div class="border-t border-paper/20">
      <div class="shell py-10 sm:py-14">
        <p class="eyebrow text-paper/90 mb-5">Worked example: 5m &times; 4m room</p>
        <div class="text-base text-paper space-y-2">
          <p class="m-0">Ordered dimensions: 5.1m &times; 4.1m (10cm trimming allowance added to each side)</p>
          <p class="m-0">Charged area: 5.1 &times; 4.1 = 20.91m&sup2;</p>
          <p class="m-0">The proposal is based on those <strong class="font-medium text-paper">20.91m&sup2;</strong>, trimming waste included.</p>
        </div>
      </div>
    </div>

    <div class="border-t border-paper/20">
      <div class="shell py-10 sm:py-14">
        <dl class="grid gap-8 sm:grid-cols-3 m-0">
          {extras.map((e) => (
            <div>
              <dt class="display text-xl mb-2">{e.title}</dt>
              <dd class="m-0 text-sm text-paper/90">{e.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Archetype: two-column split. Material information, deliberately open. -->
  <section class="section-pad">
    <div class="shell">
      <div class="grid gap-10 md:grid-cols-[0.85fr_1.15fr] md:gap-gutter">
        <div>
          <h2 class="display text-3xl sm:text-4xl m-0 max-w-[12ch]">How colour works</h2>
        </div>
        <div>
          <div class="space-y-6">
            <p class="text-lg sm:text-xl m-0">
              Every piece is dyed to match a single reference from the ARS 1,400-colour system. You select a reference from <a href={site.externalLinks.arsColours} class="link-underline" rel="noopener noreferrer">arscolors.com</a> and we match it. Physical dyed wool may vary slightly from a screen render.
            </p>
          </div>
          <p class="text-sm text-graphite m-0 mt-8 pt-6 border-t-2 border-ink">
            Dyed wool sits slightly differently to a screen. We confirm the exact colour reference with you at sign-off, before anything is made.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Archetype: full-bleed image. -->
  <section>
    <div class="media">
      <ImagePlaceholder
        id="carpet-room-context"
        width={1600}
        height={900}
        alt="A hand-woven wall-to-wall carpet in soft dove grey filling a modern master bedroom with a grey upholstered bed, a chaise by tall windows and a stone abstract painting"
        caption="Design visualisation"
        class="w-full"
        sizes="100vw"
      />
    </div>
  </section>

  <!-- Archetype: oversized closing statement. -->
  <section class="section-pad bg-ink text-paper">
    <div class="shell">
      <h2 class="display text-3xl sm:text-6xl lg:text-7xl m-0 mb-10 sm:mb-14 max-w-[12ch]">
        Start a carpet commission.
      </h2>
      <div class="flex flex-col sm:flex-row sm:items-center gap-8 sm:gap-14">
        <a href="/enquire" class="btn btn-invert self-start">Enquire</a>
        <p class="text-paper text-lg m-0">{site.responsePromise}</p>
      </div>
    </div>
  </section>
</BaseLayout>
