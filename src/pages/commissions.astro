---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';
import pricing from '../data/pricing.json';
import site from '../data/site.json';
import { PILE_HEIGHTS, MATERIALS } from '../lib/constants';

const extras = [
  { title: 'Shipping', body: pricing.shippingNote },
  { title: 'Customs and duties', body: pricing.customsNote },
];
---

<BaseLayout
  title="Bespoke Hand-Woven Rugs &amp; Wall Hangings, Made for One Room | Harrow &amp; Thread"
  description="Commission a hand-woven rug or wall hanging designed for one room, at any dimension up to 15m × 10m. Wool, silk blend, bamboo silk or flatweave, dyed to match from 1,400 colours. Priced individually in a written proposal before any deposit."
>
  <!-- Archetype: page header. Eyebrow, one real h1, lede. -->
  <section class="section-pad">
    <div class="shell">
      <p class="eyebrow text-graphite mb-6">Commissions</p>
      <h1 class="display text-3xl xs:text-4xl sm:text-5xl lg:text-6xl m-0 mb-8 max-w-[18ch]">
        A single piece,<br />made for one room.
      </h1>
      <p class="lede text-graphite m-0 max-w-[44ch]">
        A commission starts with the room. We compose the design around its dimensions, its sightlines and where the light falls, then dye the wool to your colour and weave it to size. You choose the material, the pile, the design tier and the scale. We make it, insure it and ship it. One of one, and the design becomes legally yours.
      </p>
      <!-- Phone only: the page's closing Enquire button is many screens down on a phone. -->
      <a href="/enquire" class="btn btn-primary mt-10 sm:hidden">Enquire</a>
    </div>
  </section>

  <!-- Archetype: composite specification section: cards, list rail, colour
       band and single column, so the choices never read as one repeated block. -->
  <section class="section-pad bg-chalk">
    <div class="shell">
      <h2 class="display text-3xl sm:text-4xl m-0 mb-12 sm:mb-16">What you choose</h2>

      <!-- Materials: two fibre close-ups, then four-up cards -->
      <div class="mb-20 sm:mb-28">
        <h3 class="eyebrow text-graphite mb-8">Materials</h3>
        <div class="grid gap-6 sm:grid-cols-2 sm:gap-8 mb-10 sm:mb-14">
          <figure class="m-0">
            <ImagePlaceholder id="fibre-wool" width={1600} height={1067} alt="A hank of undyed new wool fleece on natural linen, with two small skeins dyed indigo and clay beside it" caption="Design visualisation" sizes="(max-width: 768px) 100vw, 50vw" formats={['webp']} />
          </figure>
          <figure class="m-0">
            <ImagePlaceholder id="fibre-silk" width={1600} height={1067} alt="A twisted hank of ivory bamboo silk yarn on natural linen, the fibres catching the window light" caption="Design visualisation" sizes="(max-width: 768px) 100vw, 50vw" formats={['webp']} />
          </figure>
        </div>
        <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4 stagger reveal">
          {MATERIALS.map((m) => (
            <div class="border-t-2 border-ink pt-5">
              <h4 class="display text-2xl m-0 mb-3">{m.label}</h4>
              <p class="text-sm text-graphite m-0">{m.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Pile height: full-width rail of rows -->
      <div class="mb-20 sm:mb-28">
        <h3 class="eyebrow text-graphite mb-8">Pile height</h3>
        <dl class="m-0 border-t rule reveal">
          {PILE_HEIGHTS.map((p) => (
            <div class="grid gap-2 sm:grid-cols-[1fr_1.4fr] sm:gap-12 items-baseline border-b rule py-6">
              <dt class="display text-xl sm:text-2xl">{p.label}</dt>
              <dd class="m-0 text-base text-graphite">{p.chooseIf}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Size: colour band -->
      <div class="mb-20 sm:mb-28">
        <div class="bg-ink text-paper px-6 py-12 sm:px-12 sm:py-16">
          <h3 class="eyebrow text-paper/90 mb-6">Size</h3>
          <p class="display text-2xl sm:text-3xl m-0 max-w-[24ch]">
            No minimum. Maximum 15 metres by 10. Any dimension within that range.
          </p>
          <p class="text-sm text-paper/75 mt-6 max-w-[46ch]">
            Above 6 metres in any one dimension, the piece is joined from multiple sections, seamed together.
          </p>
        </div>
      </div>

      <!-- Design tier: three-up cards -->
      <div class="mb-20 sm:mb-28">
        <h3 class="eyebrow text-graphite mb-8">Design tier</h3>
        <div class="grid gap-8 sm:grid-cols-3 stagger reveal">
          {pricing.tiers.map((tier) => (
            <div class="bg-paper p-7 sm:p-8 flex flex-col h-full">
              <h4 class="display text-2xl m-0 mb-4">{tier.name}</h4>
              <p class="text-base text-graphite m-0">{tier.chooseIf}</p>
              {tier.caveat && (
                <p class="text-sm text-graphite m-0 mt-5 pt-5 border-t rule">{tier.caveat}</p>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Colour: single column -->
      <div>
        <h3 class="eyebrow text-graphite mb-6">Colour</h3>
        <p class="text-lg sm:text-xl m-0 max-w-narrow">
          Matched to a single reference in the ARS 1,400-colour system. Browse <a href={site.externalLinks.arsColours} class="link-underline" rel="noopener noreferrer">arscolors.com</a> and note the codes you want.
        </p>
      </div>
    </div>
  </section>

  <!-- Archetype: two-column split. Material information, deliberately open. -->
  <section class="section-pad">
    <div class="shell">
      <div class="grid gap-10 md:grid-cols-[0.85fr_1.15fr] md:gap-gutter">
        <div>
          <h2 class="display text-3xl sm:text-4xl m-0 max-w-[12ch]">How colour works</h2>
        </div>

        <div>
          <div class="space-y-6">
            <p class="text-lg sm:text-xl m-0">
              You pick a reference from <a href={site.externalLinks.arsColours} class="link-underline" rel="noopener noreferrer">arscolors.com</a> and we dye the wool to match it as closely as the dyeing process allows, typically within about 5% of the reference. It is the standard the mills work to, and it holds up better than matching to a posted swatch that has aged in transit.
            </p>
            <p class="text-lg sm:text-xl m-0">
              The reference is what counts, not the image on your display. Screens vary; the dye number does not.
            </p>
          </div>

          <p class="text-sm text-graphite m-0 mt-8 pt-6 border-t-2 border-ink">
            Dyed wool sits slightly differently to a screen. We confirm the exact colour reference with you at sign-off, before anything is made.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Archetype: full-bleed colour statement. How a commission is priced,
       stated in the open. No rate card: prices left the site 2026-09-13
       (client decision) — the written proposal carries the price. -->
  <section id="proposal" class="bg-ink text-paper scroll-mt-24">
    <div class="shell py-12 sm:py-20">
      <p class="eyebrow text-paper/70 mb-6">Investment</p>
      <h2 class="display text-3xl xs:text-4xl sm:text-5xl lg:text-6xl m-0 mb-8 max-w-[14ch]">
        Priced for the piece, not from a list.
      </h2>
      <p class="text-lg sm:text-xl text-paper/90 m-0 max-w-[46ch]">
        Every commission is priced individually. Once the room, the size, the
        material and the design are known, your written proposal sets out the
        investment in full, before any deposit. Nothing is made until you have
        signed off the design.
      </p>
    </div>

    <div class="border-t border-paper/20">
      <div class="shell py-10 sm:py-14">
        <dl class="grid gap-8 sm:grid-cols-3 m-0">
          {extras.map((x) => (
            <div>
              <dt class="display text-xl mb-2">{x.title}</dt>
              <dd class="m-0 text-sm text-paper/90">{x.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Archetype: 50/50 split, image flush to the page edge. The full
       wall-hanging detail (hanging rules, plates) lives on /wall-hangings;
       the id stays so older links to #wall-hangings still land. -->
  <section id="wall-hangings" class="bg-chalk scroll-mt-24">
    <div class="grid md:grid-cols-2 items-stretch">
      <div class="order-1 flex items-center">
        <div class="px-6 py-14 sm:px-14 sm:py-20 lg:pl-gutter lg:pr-20">
          <h2 class="display text-3xl sm:text-4xl m-0 mb-6 max-w-[12ch]">Wall hangings</h2>
          <p class="text-lg text-graphite m-0 mb-8 max-w-[40ch]">
            A hand-woven textile piece for the wall. Same materials, same colour system, same three design tiers. A variant of the same commission.
          </p>
          <a href="/wall-hangings" class="link-underline text-sm font-medium">How a wall hanging is made and hung &rarr;</a>
        </div>
      </div>

      <div class="media order-2 min-h-[22rem] md:min-h-[34rem]">
        <ImagePlaceholder
          id="wall-hanging-context"
          width={1600}
          height={900}
          alt="A long hand-woven wool wall hanging in soft horizontal bands of stone, ivory, mushroom and green, hung from a pole above a moss velvet bench in a panelled long gallery"
          caption="Design visualisation"
          class="w-full"
          sizes="(max-width: 1024px) 100vw, 50vw"
        />
      </div>
    </div>
  </section>

  <!-- Archetype: wide single column. Dense terms, read straight down. -->
  <section class="section-pad">
    <div class="shell">
      <div class="max-w-narrow">
        <h2 class="display text-3xl sm:text-4xl m-0 mb-6">Timeline</h2>
        <p class="text-lg sm:text-xl m-0">
          About six to seven weeks from sign-off for a straightforward piece. Scale and complexity extend it: a large pictorial takes considerably longer than a small plain one, and the honest figure cannot be known until the design is agreed. Your date is confirmed at sign-off, before the deposit.
        </p>

        <h2 id="ownership" class="display text-3xl sm:text-4xl m-0 mb-6 mt-16 scroll-mt-24">You own the design</h2>
        <p class="text-lg sm:text-xl m-0">
          On final payment we assign the copyright and design rights to you in writing. We keep no right to reuse, license or sell your design. If you would like it entered on the UK register of designs, we file the application for you and the registration fee is included: five years' protection, and yours to renew in five-year steps to twenty-five.
        </p>

        <h2 class="display text-3xl sm:text-4xl m-0 mt-16 sm:mt-20 mb-8">Terms in brief</h2>
        <div class="border-t-2 border-ink">
          <p class="text-base m-0 py-6 border-b rule">A 50% deposit confirms your order, and production usually begins within 12 to 24 hours of receiving it. The deposit is refundable until production begins, and non-refundable from then. The remaining 50% balance is payable before dispatch.</p>
          <p class="text-base m-0 py-6 border-b rule">Your order is for bespoke goods made to your personal specification. Under the Consumer Contracts Regulations 2013, you do not have the right to cancel once production has commenced.</p>
          <p class="text-base m-0 py-6 border-b rule">Every shipment is fully insured at our expense. If your piece is lost or damaged in transit, we manage the claim and prioritise a replacement.</p>
          <p class="text-base m-0 py-6 border-b rule">Bespoke goods are not returnable once production starts, but your rights under the Consumer Rights Act 2015, including for a faulty piece, are unaffected.</p>
          <p class="text-base m-0 py-6">Full terms at <a href="/terms" class="link-underline">/terms</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Archetype: oversized closing statement on ink. -->
  <section class="section-pad bg-ink text-paper">
    <div class="shell">
      <h2 class="display text-3xl sm:text-5xl lg:text-6xl m-0 mb-10 sm:mb-14 max-w-[12ch]">
        Start a commission.
      </h2>

      <div class="flex flex-col sm:flex-row sm:items-center gap-8 sm:gap-14">
        <a href="/enquire" class="btn btn-invert self-start">Enquire</a>
        <p class="text-paper/90 text-lg m-0">{site.responsePromise}</p>
      </div>
    </div>
  </section>
</BaseLayout>
