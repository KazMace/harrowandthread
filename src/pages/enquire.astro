---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { SITE_URL } from '../lib/constants';
import { FORM_FIELDS } from '../lib/constants';

// Read preselection from query params
const preselectedType = Astro.url?.searchParams.get('type') || '';
const preselectedIAm = Astro.url?.searchParams.get('iam') || '';
---

<BaseLayout
  title="Start a Rug Commission — Enquire — Harrow &amp; Thread"
  description="Tell us what you have in mind and we respond within one working day. No obligation, and no account needed to enquire."
>
  <!-- Archetype: two-column split. Form left, reassurance rail right — the
       right half was previously empty white on the site's only conversion page. -->
  <section class="section-pad">
    <div class="shell">
      <div class="grid gap-12 md:grid-cols-[1.15fr_0.85fr] md:gap-gutter items-start">
        <div>
          <p class="eyebrow text-graphite mb-6">Enquire</p>
          <h1 class="display text-4xl lg:text-5xl m-0 mb-6">
            Tell us what you have in mind.
          </h1>
          <p class="lede text-graphite m-0 mb-12">
            {site.responsePromise} No obligation, and nothing is owed at this stage.
          </p>

      <p id="form-status" role="status" aria-live="polite" class="sr-only"></p>

      <form
        id="enquiry-form"
        name="enquiry"
        method="POST"
        {...(site.formEndpoint ? {} : { 'data-netlify': 'true', 'netlify-honeypot': 'website' })}
        enctype="multipart/form-data"
        novalidate
        class="space-y-8"
        action={site.formEndpoint || '/enquire/success'}
      >
        {site.formEndpoint && (
          <input type="hidden" name="_next" value={`${SITE_URL}/enquire/success`} />
        )}
        <!-- Honeypot -->
        <div class="hidden" aria-hidden="true">
          <label>
            Leave this empty
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <!-- Name -->
        <div>
          <label for="name" class="eyebrow text-graphite block mb-2">Name <span class="text-madder" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="name"
            aria-describedby="err-name"
            name="name"
            required
            autocomplete="name"
            class="w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
          />
          <span id="err-name" class="text-sm text-madder hidden mt-1 block" data-error="name">Please enter your name.</span>
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="eyebrow text-graphite block mb-2">Email <span class="text-madder" aria-hidden="true">*</span></label>
          <input
            type="email"
            id="email"
            aria-describedby="err-email"
            name="email"
            required
            autocomplete="email"
            class="w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
          />
          <span id="err-email" class="text-sm text-madder hidden mt-1 block" data-error="email">Please enter a valid email address.</span>
        </div>

        <!-- Phone -->
        <div>
          <label for="phone" class="eyebrow text-graphite block mb-2">Phone</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            autocomplete="tel"
            class="w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
          />
        </div>

        <!-- I am -->
        <div>
          <label for="iam" class="eyebrow text-graphite block mb-2">I am <span class="text-madder" aria-hidden="true">*</span></label>
          <select
            id="iam"
            aria-describedby="err-iam"
            name="iam"
            required
            class="field-select w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
          >
            {FORM_FIELDS.enquiryType.map((opt) => (
              <option value={opt.value} selected={opt.value === preselectedIAm}>{opt.label}</option>
            ))}
          </select>
          <span id="err-iam" class="text-sm text-madder hidden mt-1 block" data-error="iam">Please select an option.</span>
        </div>

        <!-- What are you commissioning -->
        <div>
          <label for="commission-type" class="eyebrow text-graphite block mb-2">What are you commissioning <span class="text-madder" aria-hidden="true">*</span></label>
          <select
            id="commission-type"
            aria-describedby="err-commission-type"
            name="commission-type"
            required
            class="field-select w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
          >
            {FORM_FIELDS.commissionType.map((opt) => (
              <option value={opt.value} selected={opt.value === preselectedType}>{opt.label}</option>
            ))}
          </select>
          <span id="err-commission-type" class="text-sm text-madder hidden mt-1 block" data-error="commission-type">Please select an option.</span>
        </div>

        <!-- Where is it going -->
        <div>
          <label for="location" class="eyebrow text-graphite block mb-2">Where is it going <span class="text-graphite font-normal normal-case tracking-normal">(optional)</span></label>
          <input
            type="text"
            id="location"
            name="location"
            placeholder="e.g. Living room, London"
            class="w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
          />
          <span id="err-location" class="text-sm text-madder hidden mt-1 block" data-error="location">Please tell us where the piece will go.</span>
        </div>

        <!-- Size -->
        <fieldset class="border-0 p-0 m-0">
          <legend class="eyebrow text-graphite mb-3">Size <span class="text-graphite font-normal normal-case tracking-normal">(optional)</span></legend>
          <div class="flex items-end gap-4">
            <div class="flex-1">
              <label for="size-w" class="text-sm text-graphite block mb-1" data-size-label="Width (m)">Width (m)</label>
              <input
                type="number"
                id="size-w"
                name="size-w"
                min="0"
                step="0.1"
                class="w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
              />
            </div>
            <span class="text-graphite pb-3">&times;</span>
            <div class="flex-1">
              <label for="size-h" class="text-sm text-graphite block mb-1" data-size-label="Length (m)">Length (m)</label>
              <input
                type="number"
                id="size-h"
                name="size-h"
                min="0"
                step="0.1"
                class="w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
              />
            </div>
          </div>
          <div class="mt-3">
            <label class="flex items-center gap-2 text-sm text-graphite cursor-pointer">
              <input type="checkbox" id="size-unsure" name="size-unsure" value="true" class="field-check" />
              Not sure yet
            </label>
          </div>
          <span id="err-size" class="text-sm text-madder hidden mt-1 block" data-error="size">Please enter dimensions or check "Not sure yet".</span>
        </fieldset>

        <!-- Design tier -->
        <div>
          <label for="design-tier" class="eyebrow text-graphite block mb-2">Design tier <span class="text-graphite font-normal normal-case tracking-normal">(optional)</span></label>
          <select
            id="design-tier"
            name="design-tier"
                        class="field-select w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
          >
            {FORM_FIELDS.designTier.map((opt) => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
          <span id="err-design-tier" class="text-sm text-madder hidden mt-1 block" data-error="design-tier">Please select a design tier.</span>
        </div>


        <!-- Timeline -->
        <div>
          <label for="timeline" class="eyebrow text-graphite block mb-2">Timeline <span class="text-graphite font-normal normal-case tracking-normal">(optional)</span></label>
          <select
            id="timeline"
            name="timeline"
                        class="field-select w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
          >
            {FORM_FIELDS.timeline.map((opt) => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
          <span id="err-timeline" class="text-sm text-madder hidden mt-1 block" data-error="timeline">Please select a timeline.</span>
        </div>

        <!-- Design starting point -->
        <div>
          <label for="design-source" class="eyebrow text-graphite block mb-2">Design starting point <span class="text-graphite font-normal normal-case tracking-normal">(optional)</span></label>
          <select
            id="design-source"
            name="design-source"
                        class="field-select w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150"
          >
            {FORM_FIELDS.designSource.map((opt) => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
          <span id="err-design-source" class="text-sm text-madder hidden mt-1 block" data-error="design-source">Please select an option.</span>
        </div>

        <!-- Reference images -->
        <div>
          <label for="reference-images" class="eyebrow text-graphite block mb-2">Photographs of the room, or a design reference</label>
          <p class="text-sm text-graphite mb-2">Send photographs of the room and we will design to it &mdash; the proportions, the architecture, where the light falls. A sketch or a reference image is just as welcome. Up to 3 images, 10MB each. JPG, PNG or WebP.</p>
          <input
            type="file"
            id="reference-images"
            name="reference-images"
            accept="image/jpeg,image/png,image/webp"
            multiple
            class="field-file w-full text-sm text-graphite"
          />
        </div>

        <!-- Anything else -->
        <div>
          <label for="notes" class="eyebrow text-graphite block mb-2">Anything else</label>
          <textarea
            id="notes"
            name="notes"
            rows="4"
            class="w-full px-4 py-3.5 text-base text-ink bg-paper border rule focus:border-ink transition-colors duration-150 resize-y"
          ></textarea>
        </div>

        <!-- Marketing consent -->
        <div>
          <label class="flex items-start gap-3 text-sm text-graphite cursor-pointer">
            <input type="checkbox" name="marketing-consent" value="true" class="field-check mt-0.5" />
            <span>I would like to receive occasional emails about Harrow &amp; Thread. I can unsubscribe at any time.</span>
          </label>
        </div>

        <!-- Submit -->
        <div>
          <p class="text-sm text-graphite mb-5 max-w-measure">
            We use your details only to answer your enquiry. See our
            <a href="/privacy" class="link-underline text-ink">privacy policy</a>.
          </p>
          <button
            type="submit"
            class="btn btn-primary"
          >
            Submit enquiry
          </button>
        </div>

      </form>
        </div>

        <!-- Reassurance rail -->
        <aside class="md:sticky md:top-28 bg-chalk p-7 sm:p-8">
          <h2 class="display text-2xl m-0 mb-6">What happens next</h2>

          <ol class="list-none p-0 m-0 space-y-5">
            <li class="border-t rule pt-4">
              <span class="eyebrow text-graphite block mb-2">01</span>
              <p class="text-base text-ink m-0 mb-1">We reply within one working day</p>
              <p class="text-sm text-graphite m-0">With an indicative price for what you have described, and any questions we need answered to quote properly.</p>
            </li>
            <li class="border-t rule pt-4">
              <span class="eyebrow text-graphite block mb-2">02</span>
              <p class="text-base text-ink m-0 mb-1">We map the design to your dimensions</p>
              <p class="text-sm text-graphite m-0">You approve the design and the colour references before anything is made.</p>
            </li>
            <li class="border-t rule pt-4">
              <span class="eyebrow text-graphite block mb-2">03</span>
              <p class="text-base text-ink m-0 mb-1">Production begins on deposit</p>
              <p class="text-sm text-graphite m-0">Production begins on receipt of the 50% deposit. That deposit is non-refundable from the point it is paid. The balance is due before dispatch, about four weeks later.</p>
            </li>
          </ol>

          <div class="border-t-2 border-ink mt-8 pt-5 space-y-3">
            <p class="text-sm text-graphite m-0">
              <strong class="text-ink font-medium">No deposit is due at enquiry.</strong>
              Enquiring costs nothing and commits you to nothing.
            </p>
            <p class="text-sm text-graphite m-0">
              A &pound;200 design fee applies only if you ask us to assign a designer,
              and is credited in full against your commission.
            </p>
            <p class="text-sm text-graphite m-0">
              Prefer to write directly?
              <a href="mailto:enquiries@harrowandthread.com" class="link-underline text-ink">enquiries@harrowandthread.com</a>
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement;
  const commissionSelect = document.getElementById('commission-type') as HTMLSelectElement;
  const sizeWLabel = document.querySelector('[data-size-label="Width (m)"]');
  const sizeHLabel = document.querySelector('[data-size-label="Length (m)"]');
  const sizeUnsure = document.getElementById('size-unsure') as HTMLInputElement;
  const sizeW = document.getElementById('size-w') as HTMLInputElement;
  const sizeH = document.getElementById('size-h') as HTMLInputElement;

  // Dynamic size labels for carpet
  commissionSelect?.addEventListener('change', () => {
    const isCarpet = commissionSelect.value === 'carpet';
    if (sizeWLabel) {
      sizeWLabel.textContent = isCarpet ? 'Longest measurement (m)' : 'Width (m)';
    }
    if (sizeHLabel) {
      sizeHLabel.textContent = isCarpet ? 'Second longest measurement (m)' : 'Length (m)';
    }
    if (isCarpet && sizeWLabel) {
      const link = document.createElement('a');
      link.href = '/carpets';
      link.className = 'text-ink underline ml-1 text-sm';
      link.textContent = 'Measuring guidance';
      if (!sizeWLabel.querySelector('a')) {
        sizeWLabel.appendChild(link);
      }
    }
  });

  // Trigger on load for preselected carpet
  if (commissionSelect?.value === 'carpet') {
    commissionSelect.dispatchEvent(new Event('change'));
  }

  // Toggle size fields when "Not sure" is checked
  sizeUnsure?.addEventListener('change', () => {
    // Size is optional; only enable/disable. Setting `required` here would
    // contradict the "(optional)" labels and the validator, which does not
    // gate on these fields.
    const disabled = sizeUnsure.checked;
    sizeW.disabled = disabled;
    sizeH.disabled = disabled;
  });

  // Inline validation.
  //
  // CRITICAL: only cancel the submit when validation FAILS. A previous version
  // called preventDefault() unconditionally and then revealed a client-side
  // "success" panel, so the form never posted anywhere — every enquiry was
  // silently discarded while the visitor was told it had been sent. On success
  // we let the native POST proceed to the configured endpoint, which redirects
  // to /enquire/success.
  const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SB_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const W3F_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY;
  const CONTACT_EMAIL = 'enquiries@harrowandthread.com';

  form?.addEventListener('submit', (e) => {
    let valid = true;
    let firstInvalid: HTMLElement | null = null;

    // Clear previous errors
    form.querySelectorAll('[data-error]').forEach((el) => {
      (el as HTMLElement).classList.add('hidden');
    });
    form.querySelectorAll('[aria-invalid]').forEach((el) => {
      el.removeAttribute('aria-invalid');
    });

    // Only four fields gate a first contact. Everything else is useful but
    // optional — nine required fields was costing enquiries on a page whose
    // entire job is to receive them.
    const requiredFields = [
      { id: 'name', errorId: 'name' },
      { id: 'email', errorId: 'email' },
      { id: 'iam', errorId: 'iam' },
      { id: 'commission-type', errorId: 'commission-type' },
    ];

    function fail(id: string, errorId: string) {
      const field = document.getElementById(id);
      const error = form.querySelector(`[data-error="${errorId}"]`);
      if (error) (error as HTMLElement).classList.remove('hidden');
      if (field) {
        field.setAttribute('aria-invalid', 'true');
        if (!firstInvalid) firstInvalid = field as HTMLElement;
      }
      valid = false;
    }

    for (const { id, errorId } of requiredFields) {
      const field = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
      if (!field?.value) fail(id, errorId);
    }

    const email = document.getElementById('email') as HTMLInputElement;
    if (email?.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
      fail('email', 'email');
    }

    const status = document.getElementById('form-status');
    if (status) {
      const n = form.querySelectorAll('[aria-invalid="true"]').length;
      status.textContent = n
        ? `${n} ${n === 1 ? 'field needs' : 'fields need'} attention before this can be sent.`
        : '';
    }

    if (!valid) {
      // Without native validation bubbles, nothing appears to happen on submit
      // unless we move the user to the problem ourselves.
      e.preventDefault();
      firstInvalid?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      firstInvalid?.focus({ preventScroll: true });
      return;
    }

    // ---- Valid submission -------------------------------------------------
    //
    // Two destinations. Files and the full record go to Supabase; Web3Forms
    // only sends a notification email, so its free tier (no attachments) is
    // enough. Files upload FIRST: if the notification later fails the enquiry
    // is still captured, and losing an email is recoverable where losing the
    // enquiry is not.
    //
    // Both keys here are public by design. That is only safe because the
    // `enquiries` table and the `enquiry-uploads` bucket are insert-only for
    // the anon role. Without those RLS policies anyone reading this page could
    // read every enquiry ever sent. See NOTES-codebase.md.
    //
    // Until the keys exist this whole block is skipped and the form posts
    // natively exactly as before.
    if (!SB_URL || !SB_KEY) return;

    e.preventDefault();

    const submitBtn = form.querySelector('button[type=submit]') as HTMLButtonElement | null;
    const say = (msg: string, visible = false) => {
      if (!status) return;
      status.textContent = msg;
      status.classList.toggle('sr-only', !visible);
      if (visible) status.classList.add('text-sm', 'text-madder', 'mb-4', 'block');
    };

    (async () => {
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
      say('Sending your enquiry.');

      const fd = new FormData(form);

      // Honeypot: behave exactly as success, store nothing.
      if (fd.get('website')) { window.location.assign('/enquire/success'); return; }

      const sbHeaders = { apikey: SB_KEY, Authorization: `Bearer ${SB_KEY}` };

      const picker = document.getElementById('reference-images') as HTMLInputElement | null;
      const chosen = Array.from(picker?.files ?? []).slice(0, 3);
      const folder = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
      const uploaded: string[] = [];
      let storageFailed = false;
      let dbSaved = false;
      let mailSent = false;

      // 1 · Room photographs and references -> Supabase Storage
      for (const file of chosen) {
        try {
          if (file.size > 10 * 1024 * 1024) throw new Error('too large');
          const safe = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
          const res = await fetch(
            `${SB_URL}/storage/v1/object/enquiry-uploads/${folder}/${safe}`,
            { method: 'POST', headers: sbHeaders, body: file }
          );
          if (!res.ok) throw new Error('upload failed');
          uploaded.push(`${folder}/${safe}`);
        } catch { storageFailed = true; }
      }

      // 2 · The record -> Supabase. Hyphenated field names become columns.
      const row: Record<string, unknown> = { upload_paths: uploaded };
      for (const [k, v] of fd.entries()) {
        if (k === 'website' || k === 'reference-images') continue;
        row[k.replace(/-/g, '_')] = typeof v === 'string' ? v : null;
      }
      try {
        const ins = await fetch(`${SB_URL}/rest/v1/enquiries`, {
          method: 'POST',
          headers: { ...sbHeaders, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify(row),
        });
        dbSaved = ins.ok;
      } catch { dbSaved = false; }

      // 3 · Notification email. Sent even when Supabase failed, and told so, so
      // a lead is never lost while the database is unreachable. Web3Forms' free
      // tier only accepts browser-side calls — which this is.
      // 3 · Notification email, sent as a NATIVE form POST rather than fetch.
      //
      // fetch() to Web3Forms is blocked by CORS: with a JSON content-type the
      // preflight is rejected, and even as FormData the response carries no
      // Access-Control-Allow-Origin for our origin. A native form submission is
      // not subject to CORS at all, which is exactly why Web3Forms' own example
      // is a plain <form>. Their `redirect` field brings the visitor back to our
      // success page afterwards. Do not "modernise" this into a fetch.
      if (W3F_KEY) {
        const alerts: string[] = [];
        if (!dbSaved) alerts.push('WARNING: this enquiry could NOT be saved to the database. This email is the only record of it.');
        if (storageFailed) alerts.push('WARNING: one or more images the sender attached failed to upload.');

        const post = document.createElement('form');
        post.method = 'POST';
        post.action = 'https://api.web3forms.com/submit';
        post.style.display = 'none';

        const add = (k: string, v: string) => {
          const i = document.createElement('input');
          i.type = 'hidden'; i.name = k; i.value = v;
          post.appendChild(i);
        };
        add('access_key', W3F_KEY);
        add('subject', `New commission enquiry — ${row.name ?? 'unnamed'}`);
        add('from_name', 'Harrow & Thread website');
        add('redirect', `${window.location.origin}/enquire/success`);
        for (const [k, v] of Object.entries(row)) {
          if (k === 'upload_paths') continue;
          if (v != null && v !== '') add(k, String(v));
        }
        add('images', uploaded.length
          ? uploaded.map((pth) => `${SB_URL}/storage/v1/object/enquiry-uploads/${pth}`).join(' | ')
          : 'none attached');
        if (alerts.length) add('alerts', alerts.join(' '));

        document.body.appendChild(post);
        post.submit();   // navigates; Web3Forms redirects to /enquire/success
        return;
      }

      // Only a total failure is worth stopping the visitor for.
      if (dbSaved || mailSent) { window.location.assign('/enquire/success'); return; }

      say(`We could not send your enquiry. Please try again, or email us directly at ${CONTACT_EMAIL}.`, true);
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send enquiry'; }
    })();
  });
</script>