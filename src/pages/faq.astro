---
import BaseLayout from '../layouts/BaseLayout.astro';

// Questions and answers live here as data, and drive BOTH the rendered
// accordions and the FAQPage structured data below. An earlier version
// hand-maintained the schema separately and it had drifted to covering only
// 5 of 18 questions — the ones AI answer engines most want (measuring,
// customs, sizes, pile vs flatweave) were missing entirely.
import { faq } from '../data/faq';

// Strip markup for the schema — JSON-LD wants plain text.
const slug = (t) => t.replace(/&amp;/g, 'and').replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-|-$/g, '').toLowerCase();

const stripTags = (html) => html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&mdash;/g, '—').replace(/&times;/g, '×').replace(/&sup2;/g, '²').replace(/&pound;/g, '£').replace(/&minus;/g, '−').replace(/\s+/g, ' ').trim();

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: stripTags(item.q),
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a.map(stripTags).join(' '),
      },
    }))
  ),
});
---

<BaseLayout
  title="Bespoke Rug FAQs: Cost, Sizes, Lead Times | Harrow &amp; Thread"
  description="How a bespoke hand-woven rug is priced, minimum and maximum sizes, materials, pile heights, lead times, shipping, customs and returns. Answered plainly."
  schema={faqSchema}
>
  <section class="section-pad">
    <div class="shell">
      <div class="max-w-narrow mb-14 sm:mb-20">
        <p class="eyebrow text-graphite mb-6">Frequently asked questions</p>
        <h1 class="display text-3xl xs:text-4xl sm:text-5xl lg:text-6xl m-0 mb-6">
          Questions, answered.
        </h1>
        <p class="lede text-graphite m-0">
          Answers to the questions we get most often. If you cannot find what you are looking for, <a href="/enquire" class="link-underline">ask us</a>.
        </p>
      </div>

      <div class="grid gap-12 md:grid-cols-[1fr_16rem] md:gap-gutter items-start">
      <div>
        {faq.map((group) => (
          <div class="mb-14 sm:mb-16 last:mb-0" id={slug(group.category)}>
            <h2 class="display text-2xl sm:text-3xl text-ink mb-6" set:html={group.category}></h2>
            <div>
              {group.items.map((item) => (
                <details class="group border-b rule py-5">
                  <summary class="text-lg text-ink font-medium cursor-pointer list-none flex justify-between items-start gap-6">
                    <span set:html={item.q}></span>
                    <span class="text-graphite text-xl leading-none shrink-0 group-open:hidden">+</span>
                    <span class="text-graphite text-xl leading-none shrink-0 hidden group-open:inline">&minus;</span>
                  </summary>
                  {item.a.map((para, i) => (
                    <p class={`prose-body text-graphite mb-0 ${i === 0 ? 'mt-4' : 'mt-3'}`} set:html={para}></p>
                  ))}
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>

        <!-- Category rail + a route out for anything not covered. -->
        <aside class="md:sticky md:top-28">
          <nav aria-label="Question categories" class="mb-8">
            <p class="eyebrow text-graphite mb-4">On this page</p>
            <ul class="list-none p-0 m-0 space-y-2.5 border-t rule pt-4">
              {faq.map((group) => (
                <li>
                  <a href={`#${slug(group.category)}`} class="text-sm text-graphite hover:text-ink no-underline" set:html={group.category}></a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="bg-chalk p-6">
            <p class="text-base text-ink m-0 mb-2">Not covered here?</p>
            <p class="text-sm text-graphite m-0 mb-5">
              Tell us what you have in mind and we will answer directly, within one working day.
            </p>
            <a href="/enquire" class="btn btn-primary !py-3 !px-6 !text-sm">Ask us</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
