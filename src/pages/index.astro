---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import CategoryTiles from '../components/home/CategoryTiles.astro';
import RendersGrid from '../components/home/RendersGrid.astro';
import ColourRail from '../components/home/ColourRail.astro';
import CarpetsStrip from '../components/home/CarpetsStrip.astro';
import TheMaison from '../components/home/TheMaison.astro';
import ProcessStrip from '../components/home/ProcessStrip.astro';
import Details from '../components/home/Details.astro';
import EnquiryCTA from '../components/home/EnquiryCTA.astro';

// Machine-readable description of the service. No rate card: prices left the
// site on 2026-09-13 (client decision) — every commission is priced in a
// written proposal. No aggregateRating or review — there are no genuine
// reviews and inventing them is a banned practice under the UK DMCC Act 2024.
const serviceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://harrowandthread.com/#commission-service',
  name: 'Bespoke Hand-Woven Rug, Wall Hanging and Carpet Commissions',
  serviceType: 'Bespoke rug commission',
  provider: { '@id': 'https://harrowandthread.com/#organization' },
  areaServed: ['GB', 'EU', 'US'],
  description:
    'Made-to-order hand-woven rugs, wall hangings and wall-to-wall carpets in wool, silk blend, bamboo silk or flatweave. Every commission is priced individually in a written proposal before any deposit. About six to seven weeks from sign-off for a straightforward piece; larger and more complex commissions take longer, confirmed at sign-off.',
});
---

<BaseLayout
  title="Bespoke Hand-Woven Rugs, Made to Order | Harrow &amp; Thread"
  description="Bespoke hand-woven rugs, wall hangings and wall-to-wall carpets, each designed for one room and dyed to match from 1,400 colours. Priced in a written proposal."
  schema={serviceSchema}
>
  <Hero />
  <CategoryTiles />
  <RendersGrid />
  <ColourRail />
  <CarpetsStrip />
  <TheMaison />
  <ProcessStrip />
  <Details />
  <EnquiryCTA />
</BaseLayout>
