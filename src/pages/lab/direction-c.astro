---
// DIRECTION C — "Room"
// Throwaway design exploration. Delete src/pages/lab/ before rollout.
//
// Logic: one rug per screen. Each piece gets a full section to itself, sitting
// complete and uncropped on a ground tinted from its own dominant dye, so the
// page changes colour as you scroll and the colour always belongs to the wool.
// Type is kept to one enormous line per screen and a short specification —
// closest in spirit to sonyawinner.com, and the direction that gains the most
// when the photography gets better.
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/fraunces';

const rooms = [
  {
    img: 'whole-hero', line: 'Made once. For you. Never again.',
    tier: 'Pictorial', spec: '3 × 2m · wool · 12mm pile', dyes: 'Indigo · Madder · Ochre · Bone',
    ground: '#E7E3DA', ink: '#171410',
  },
  {
    img: 'whole-geo', line: 'Any design you can put in front of us.',
    tier: 'Geometric', spec: '4 × 3m · wool · 6mm pile', dyes: 'Charcoal · Saffron · Cream',
    ground: '#2A2723', ink: '#F3F0E9',
  },
  {
    img: 'whole-plain', line: 'One colour, matched from fourteen hundred.',
    tier: 'Plain', spec: '3.5 × 2.5m · wool · 20mm pile', dyes: 'Deep teal, ARS 6210',
    ground: '#16302F', ink: '#EAF0EE',
  },
];
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Direction C — Room — Harrow &amp; Thread</title>
  </head>
  <body>
    <header class="bar">
      <a class="wordmark" href="/lab/direction-c">Harrow &amp; Thread</a>
      <a class="go" href="/enquire">Start a commission</a>
    </header>

    <section class="open">
      <h1>A rug that<br />exists once.</h1>
      <p>
        Bespoke, hand-tufted, drawn to your design and dyed to your colour.
        Any dimension to fifteen metres by ten. Four weeks from sign-off.
      </p>
    </section>

    <!-- One rug per screen. Complete, uncropped, on a ground taken from its own dye. -->
    {rooms.map((r) => (
      <section class="room" style={`background:${r.ground}; color:${r.ink}`}>
        <div class="room-grid">
          <div class="room-words">
            <h2>{r.line}</h2>
            <dl>
              <div><dt>Tier</dt><dd>{r.tier}</dd></div>
              <div><dt>Specification</dt><dd>{r.spec}</dd></div>
              <div><dt>Dyes</dt><dd>{r.dyes}</dd></div>
            </dl>
            <p class="viz">Design visualisation</p>
          </div>
          <figure>
            <img
              src={`/images/lab/${r.img}-1600w.webp`}
              srcset={`/images/lab/${r.img}-800w.webp 800w, /images/lab/${r.img}-1600w.webp 1600w`}
              sizes="(min-width: 900px) 56vw, 92vw"
              alt={`A ${r.tier.toLowerCase()} hand-tufted rug, shown in full`}
              width="1600" height="900" loading="lazy" decoding="async"
            />
          </figure>
        </div>
      </section>
    ))}

    <section class="rates">
      <div class="rates-head">
        <h2>Rates</h2>
        <p>
          Priced by area and design tier. The rate covers the whole piece — material,
          dyeing, tufting, finishing and insured delivery to the UK, Europe and the
          United States. Your rate is confirmed at quote, once we know the design.
        </p>
      </div>
      <div class="rate-list">
        <div><span>Plain</span><b>from £600<i>/m²</i></b><em>A single colour across the whole piece</em></div>
        <div><span>Geometric</span><b>from £900<i>/m²</i></b><em>A pattern, as a border or all over</em></div>
        <div><span>Pictorial</span><b>from £1,200<i>/m²</i></b><em>A scene, painterly or photographic</em></div>
      </div>
      <p class="fine">
        A £200 design fee applies only if you ask us to assign a designer, credited in
        full against your commission. Import duties and destination VAT are payable by
        the recipient on arrival.
      </p>
    </section>

    <section class="end">
      <h2>Tell us what you want made.</h2>
      <a class="go big" href="/enquire">Start a commission</a>
      <p class="fine">We reply within one working day.</p>
    </section>

    <style is:global>
      :root { --paper: #F3F0E9; --ink: #171410; --dim: #6E685E; }
      * { box-sizing: border-box; }
      html { overflow-x: clip; }
      body {
        margin: 0; background: var(--paper); color: var(--ink);
        font-family: 'Schibsted Grotesk Variable', system-ui, sans-serif;
        font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased;
      }
      :focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
      img { display: block; max-width: 100%; height: auto; }
      h1, h2 { margin: 0; font-weight: 500; letter-spacing: -0.03em; text-wrap: balance; }

      .bar {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
      }
      .wordmark {
        font-family: 'Fraunces Variable', Georgia, serif; font-size: 1.25rem;
        color: inherit; text-decoration: none; letter-spacing: -0.01em;
      }
      .go {
        color: inherit; text-decoration: none; font-size: 0.875rem;
        border-bottom: 1px solid currentColor; padding-bottom: 0.25rem;
        transition: opacity 200ms ease;
      }
      .go:hover { opacity: 0.6; }
      .go.big { font-size: 1.25rem; }

      .open { padding: clamp(3rem, 12vh, 8rem) clamp(1.25rem, 5vw, 4rem) clamp(4rem, 10vh, 7rem); }
      .open h1 { font-size: clamp(3rem, 12vw, 10rem); line-height: 0.9; }
      .open p { max-width: 34rem; color: var(--dim); margin: 2.5rem 0 0; }

      /* One rug per screen, ground tinted from the rug's own dye. */
      .room { padding: clamp(3.5rem, 10vh, 7rem) clamp(1.25rem, 5vw, 4rem); }
      .room-grid {
        display: grid; gap: clamp(2rem, 5vw, 4rem);
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
        align-items: center; max-width: 96rem; margin: 0 auto;
      }
      .room:nth-of-type(even) .room-grid { direction: rtl; }
      .room:nth-of-type(even) .room-grid > * { direction: ltr; }
      .room h2 { font-size: clamp(1.75rem, 3.6vw, 3.25rem); line-height: 1.05; max-width: 15ch; }
      .room dl { margin: 2.5rem 0 0; }
      .room dl > div {
        display: grid; grid-template-columns: 8rem 1fr; gap: 1rem;
        padding: 0.75rem 0; border-top: 1px solid currentColor;
      }
      .room dl > div:first-child { border-top-width: 2px; }
      .room dt {
        font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase;
        opacity: 0.65;
      }
      .room dd { margin: 0; font-size: 0.9375rem; }
      .room .viz {
        margin: 1.75rem 0 0; font-size: 0.6875rem; letter-spacing: 0.16em;
        text-transform: uppercase; opacity: 0.55;
      }
      .room figure { margin: 0; }

      .rates { padding: clamp(5rem, 14vh, 10rem) clamp(1.25rem, 5vw, 4rem); }
      .rates-head {
        display: flex; flex-wrap: wrap; gap: 2rem; justify-content: space-between;
        align-items: end; margin-bottom: 3rem;
      }
      .rates h2 { font-size: clamp(2rem, 5vw, 3.5rem); }
      .rates-head p { max-width: 40rem; color: var(--dim); font-size: 0.9375rem; margin: 0; }
      .rate-list > div {
        display: grid; grid-template-columns: minmax(0,14rem) minmax(0,12rem) 1fr;
        gap: 0.5rem 2.5rem; align-items: baseline;
        padding: 1.75rem 0; border-top: 1px solid var(--ink);
      }
      .rate-list span { font-size: clamp(1.375rem, 2.8vw, 2rem); }
      .rate-list b {
        font-weight: 500; font-size: clamp(1.125rem, 2.2vw, 1.625rem);
        font-variant-numeric: tabular-nums; white-space: nowrap;
      }
      .rate-list i { font-style: normal; font-size: 0.875rem; color: var(--dim); }
      .rate-list em { font-style: normal; color: var(--dim); font-size: 0.9375rem; }
      .fine { max-width: 44rem; color: var(--dim); font-size: 0.875rem; margin-top: 2.5rem; }

      .end {
        padding: clamp(5rem, 16vh, 12rem) clamp(1.25rem, 5vw, 4rem);
        display: grid; gap: 2rem; justify-items: start;
        border-top: 1px solid var(--ink);
      }
      .end h2 { font-size: clamp(2.25rem, 7vw, 5rem); line-height: 1.02; max-width: 15ch; }

      @media (max-width: 899px) {
        .room-grid { grid-template-columns: 1fr; }
        .room:nth-of-type(even) .room-grid { direction: ltr; }
        .rate-list > div { grid-template-columns: 1fr; gap: 0.35rem; }
        .room dl > div { grid-template-columns: 6.5rem 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </body>
</html>
