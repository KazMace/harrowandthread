---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryCTA from '../components/home/EnquiryCTA.astro';

// The trust page. It replaces the rate card that left the site on 2026-09-13:
// with no public price, what carries the decision is the sequence — nothing
// made until sign-off, the investment in writing before any deposit, the
// design assigned on final payment. Every line here restates copy that
// already exists on /commissions, /enquire, /terms or the FAQ. No new claims.
const steps = [
  {
    title: 'Tell us about the room',
    body: 'The room, the size and roughly what you have in mind. Photographs help: the proportions, the architecture, where the light falls. Enquiring costs nothing and commits you to nothing. We reply within one working day.',
  },
  {
    title: 'A written proposal',
    body: 'Once the material and the design are agreed, your proposal sets out the investment in full. For a carpet it shows the charged area, trimming waste included. It comes before any deposit.',
  },
  {
    title: 'The design, mapped to your dimensions',
    body: 'We compose the design around the room: its dimensions, its sightlines and where the light falls. Then we map it to the exact scale of your piece and match the colour to a single reference in the ARS 1,400-colour system.',
  },
  {
    title: 'Sign-off, in writing',
    body: 'You approve the design and the colour references, and your delivery date is confirmed at the same time. After sign-off the piece is fixed: once the frame is warped and the dye is mixed, it cannot be altered.',
  },
  {
    title: 'Production begins',
    body: 'A 50% deposit confirms the order and production begins. About six to seven weeks from sign-off to dispatch for a straightforward piece; larger and more complex pieces take longer, and the date is the one confirmed at sign-off.',
  },
  {
    title: 'Insured delivery',
    body: 'The balance is due before dispatch. Every piece travels rolled around a core, wrapped and boxed, and every shipment is insured at our expense. Shipping is included to the UK, Europe and the United States for most commissions, and delivery usually takes around two weeks.',
  },
  {
    title: 'Yours, in writing',
    body: 'On final payment we assign the copyright and design rights to you. We keep no right to remake it, sell it or license it. One commission, one piece.',
  },
];

// The pile close-up that sat here came off on 2026-09-13 (client): loose
// threads and a whipped edge read as a cheap rug, not a bound tufted piece.
// A proper macro shot goes back in once the images are regenerated.
---

<BaseLayout
  title="How a Commission Works | Harrow &amp; Thread"
  description="How a commission works: enquiry, written proposal, design mapped to your room, sign-off, production and insured delivery, with the design assigned to you."
>
  <!-- Archetype: page header. The feeling and the outcome, not the mechanics. -->
  <section class="section-pad">
    <div class="shell">
      <p class="eyebrow text-graphite mb-6">Process</p>
      <h1 class="display text-3xl xs:text-4xl sm:text-5xl lg:text-6xl m-0 mb-8 max-w-[18ch]">
        It starts with the room.<br />It ends with a piece that exists once.
      </h1>
      <p class="lede text-graphite m-0 max-w-[44ch]">
        Seven steps between a first message and a rug that is yours alone. Nothing is made until you have signed off the design, and the investment is set out in writing before any deposit.
      </p>
      <!-- Phone only: the page's closing Enquire button is many screens down on a phone. -->
      <a href="/enquire" class="btn btn-primary mt-10 sm:hidden">Enquire</a>
    </div>
  </section>

  <!-- Archetype: numbered sequence, one step per row, read straight down. -->
  <section class="section-pad bg-chalk">
    <div class="shell">
      <ol class="list-none p-0 m-0 border-t-2 border-ink">
        {steps.map((step, i) => (
          <li class="border-b rule py-10 sm:py-14 reveal">
              <div class="max-w-narrow">
                <h2 class="display text-2xl sm:text-3xl m-0 mb-4">{step.title}</h2>
                <p class="prose-body text-graphite m-0">{step.body}</p>
              </div>
            </li>
        ))}
      </ol>
    </div>
  </section>

  <EnquiryCTA />
</BaseLayout>
